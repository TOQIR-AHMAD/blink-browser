// Windows version resource. Generated by CMake from the project version.
// No company GUID, no build identifier: nothing here identifies the machine
// the binary was built on (PLAN.md §49).

#include <windows.h>

IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/packaging/windows/PrivacyBrowser.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Privacy Browser"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "PrivacyBrowser"
            VALUE "OriginalFilename", "PrivacyBrowser.exe"
            VALUE "ProductName", "Privacy Browser"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
